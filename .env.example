# Copia a .env y completa con valores reales. NUNCA versiones .env.
# En AWS Lambda las variables se configuran en la propia función. No se usa
# AWS Secrets Manager.

# Clave de la cuenta de anti-captcha.
ANTICAPTCHA_API_KEY=

# Modo estático: clave del portal del SRI por RUC (13 dígitos, incluye el
# dígito verificador).
SRI_PASSWORD_1790012345001=
SRI_PASSWORD_1234567890=

# Modo dinámico: clave privada del robot para abrir sealed_credentials.
# Genérela con: sri-txt-robot generar-claves --privada <archivo>
# No la versiones ni la ponga en config/robots.yaml.
SRI_CREDENTIALS_PRIVATE_KEY=
# Opcional durante una rotación: la clave privada anterior sigue aceptándose.
SRI_CREDENTIALS_PRIVATE_KEY_ANTERIOR=
# Antigüedad máxima de un sobre, en segundos. 0 desactiva la comprobación.
SRI_CREDENTIALS_MAX_AGE_SECONDS=86400

# Callback firmado al terminar cada invocación (opcional).
# El secreto debe tener al menos 16 caracteres y coincidir con el receptor.
SRI_CALLBACK_URL=
SRI_CALLBACK_SECRET=
# Hosts autorizados si el evento propone su propia callback_url.
SRI_CALLBACK_ALLOWED_HOSTS=
SRI_CALLBACK_TIMEOUT_SECONDS=10
SRI_CALLBACK_ATTEMPTS=3
SRI_CALLBACK_BACKOFF_SECONDS=1

# Despliegue ZIP: bundle del navegador y perfil en S3.
# En la imagen de contenedor estas variables no se definen.
SRI_RUNTIME_BUCKET=
SRI_RUNTIME_BROWSER_KEY=
SRI_RUNTIME_BROWSER_SHA256=
SRI_RUNTIME_PERFIL_KEY=
SRI_RUNTIME_PERFIL_SHA256=
SRI_RUNTIME_DIR=/tmp/sri-runtime
